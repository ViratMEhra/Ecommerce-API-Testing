import express from "express";
import cors from "cors";

const app = express();
app.use(cors());
app.use(express.json());

// ---------------------- Mock Data ----------------------
let orders = [
  {
    Order_id: 1,
    Customer_id: 15234,
    status: "Delivered",
    items: [
      { product_id: 500, variant_id: 6231, quantity: "5 items", price: 1200 },
      { product_id: 600, variant_id: 6232, quantity: "3 items", price: 200 },
    ],
    total_amount: {
      subtotal: 5000,
      tax: "2%",
      shipping_cost: 200,
      discount: 200,
      grand_total: 5200,
    },
    payment: { method: "UPI", status: "Paid" },
  },
  {
    Order_id: 2,
    Customer_id: 16235,
    status: "Departured",
    items: [
      { product_id: 700, variant_id: 6233, quantity: "3 items", price: 400 },
    ],
    total_amount: {
      subtotal: 2600,
      tax: "3%",
      shipping_cost: 120,
      discount: 85,
      grand_total: 2635,
    },
    payment: { method: "CashOnDelivery", status: "Pending" },
  },
];

// ---------------------- Routes ----------------------

// GET all orders
app.get("/orders", (req, res) => {
  res.status(200).json({ orders });
});

// GET order by ID
app.get("/orders/:id", (req, res) => {
  const order = orders.find(o => o.Order_id === parseInt(req.params.id));
  if (!order) return res.status(404).json({ message: "Order not found" });
  res.status(200).json(order);
});

// POST new order
app.post("/createOrder", (req, res) => {
  const newOrder = req.body;
  newOrder.Order_id = orders.length + 1;
  orders.push(newOrder);
  res.status(201).json(newOrder);
});

// PUT update order status
app.put("/updateStatus/:id", (req, res) => {
  const order = orders.find(o => o.Order_id === parseInt(req.params.id));
  if (!order) return res.status(404).json({ message: "Order not found" });

  order.status = req.body.status;
  res.status(200).json(order);
});

// DELETE order
app.delete("/cancelOrder/:id", (req, res) => {
  orders = orders.filter(o => o.Order_id !== parseInt(req.params.id));
  res.status(204).send();
});

// GET payments
app.get("/payments", (req, res) => {
  const payments = orders.map(o => o.payment);
  res.status(200).json(payments);
});

// Invalid endpoint handler
app.use("*", (req, res) => {
  res.status(404).json({ message: "Endpoint not found" });
});

// ---------------------- Server Start ----------------------
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`🚀 Server running on http://localhost:${PORT}`));
