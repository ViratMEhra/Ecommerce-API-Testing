//RESPONSE TIME CHECK(FOR EVERY REQUEST)

pm.test("Status code is 200", function () {
    pm.response.to.have.status(200);
});

pm.test("Response time is under 1000ms", function () {
    pm.expect(pm.response.responseTime).to.be.below(1000);
});

pm.test("Response is valid JSON", function () {
    pm.response.to.be.json;
});

//AUTH – LOGIN API TESTS

let jsonData = pm.response.json();

pm.test("Login successful", function () {
    pm.expect(jsonData.success).to.eql(true);
});

pm.test("Access token exists", function () {
    pm.expect(jsonData.tokens.access_token).to.not.be.undefined;
});

pm.environment.set("access_token", jsonData.tokens.access_token);

//Login – Invalid Password
pm.test("Login failed for invalid credentials", function () {
    pm.expect(pm.response.json().success).to.eql(false);
});

//USER PROFILE TESTS

let user = pm.response.json().data;

pm.test("User ID exists", function () {
    pm.expect(user.user_id).to.be.a("number");
});

pm.test("Email format is valid", function () {
    pm.expect(user.email).to.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/);
});

//CART API TEST SCRIPTS

let cart = pm.response.json()[0];

pm.test("Cart contains items", function () {
    pm.expect(cart.items.length).to.be.above(0);
});

cart.items.forEach(item => {
    pm.test("Item quantity valid", function () {
        pm.expect(item.quantity).to.be.at.least(1);
    });
});

let calculatedTotal = 0;

cart.items.forEach(item => {
    calculatedTotal += item.quantity * item.price;
});

pm.test("Cart total matches sum", function () {
    pm.expect(cart.cart_total).to.eql(calculatedTotal);
});

//PRODUCT API TESTS

pm.response.json().forEach(product => {
    pm.test("Product has variants", function () {
        pm.expect(product.variants.length).to.be.above(0);
    });
});

pm.response.json().forEach(product => {
    product.variants.forEach(variant => {
        pm.test("Stock not negative", function () {
            pm.expect(variant.stock).to.be.at.least(0);
        });
    });
});

pm.response.json().forEach(product => {
    pm.test("Rating between 1 and 5", function () {
        pm.expect(product.rating).to.be.within(1, 5);
    });
});

//ORDERS API TEST SCRIPTS

pm.response.json().orders.forEach(order => {
    pm.test("Order ID exists", function () {
        pm.expect(order.order_id).to.be.a("number");
    });
});
const validStatus = ["Delivered", "Departed", "Cancelled", "Returned"];

pm.response.json().orders.forEach(order => {
    pm.test("Order status valid", function () {
        pm.expect(validStatus).to.include(order.status);
    });
});

pm.response.json().orders.forEach(order => {
    if (order.status === "Delivered") {
        pm.test("Delivered order must be paid", function () {
            pm.expect(order.payment.status).to.eql("Paid");
        });
    }
});

pm.response.json().orders.forEach(order => {
    let total = order.total_amount.subtotal
              + order.total_amount.shipping_cost
              - order.total_amount.discount;

    pm.test("Grand total valid", function () {
        pm.expect(order.total_amount.grand_total).to.eql(total);
    });
});

//PAYMENT TESTS

pm.response.json().orders.forEach(order => {
    if (order.payment.method === "CashOnDelivery") {
        pm.test("COD payment pending", function () {
            pm.expect(order.payment.status).to.eql("Pending");
        });
    }
});

//SECURITY & EDGE TESTS

pm.test("Unauthorized request blocked", function () {
    pm.expect([401, 403]).to.include(pm.response.code);
});

//SCHEMA VALIDATION

pm.test("Order schema validation", function () {
    pm.expect(pm.response.json().orders[0]).to.have.keys(
        "order_id",
        "customer_id",
        "status",
        "items",
        "total_amount",
        "payment",
        "delivery"
    );
});



