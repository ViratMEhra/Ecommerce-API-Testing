1️⃣ GET /orders

Purpose: Verify if orders are fetched correctly
Tests:

pm.test("Status code is 200", function () {
    pm.response.to.have.status(200);
});

pm.test("Response time is less than 800ms", function () {
    pm.expect(pm.response.responseTime).to.be.below(800);
});

pm.test("Response should be in JSON format", function () {
    pm.response.to.be.json;
});

pm.test("Orders array is not empty", function () {
    var jsonData = pm.response.json();
    pm.expect(jsonData.orders.length).to.be.above(0);
});

pm.test("Each order should have Order_id and status", function () {
    var jsonData = pm.response.json();
    jsonData.orders.forEach(order => {
        pm.expect(order).to.have.property("Order_id");
        pm.expect(order).to.have.property("status");
    });
});

2️⃣ GET /orders/:id

Purpose: Fetch a single order
Tests:

pm.test("Status code is 200 or 404 for invalid ID", function () {
    pm.expect([200, 404]).to.include(pm.response.code);
});

pm.test("If 200, Order data should have total_amount field", function () {
    if (pm.response.code === 200) {
        let order = pm.response.json();
        pm.expect(order).to.have.property("total_amount");
    }
});

